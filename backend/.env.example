# Base de datos PostgreSQL (Render te da esta URL automáticamente)
DATABASE_URL=postgresql://usuario:password@host:5432/dian_facturas

# JWT Secret (genera uno aleatorio, ej: openssl rand -hex 32)
JWT_SECRET=tu_secreto_jwt_muy_seguro_aqui

# Gmail OAuth2 (obtenido en Google Cloud Console)
GMAIL_CLIENT_ID=tu_client_id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=tu_client_secret
GMAIL_REDIRECT_URI=https://tu-app.onrender.com/api/gmail/callback
GMAIL_REFRESH_TOKEN=se_genera_al_conectar_gmail

# Cuenta de Gmail a monitorear
GMAIL_USER=facturas@tuempresa.com

# URL del frontend (para CORS)
FRONTEND_URL=https://tu-frontend.onrender.com

# Puerto (Render lo asigna automáticamente)
PORT=3001

# Intervalo de sync en horas (default 2)
SYNC_INTERVAL_HOURS=2
